# ---------------------------------------------------------------------------
# Packages Group Sentiment & Reputation Monitor — environment configuration
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/packages_monitor

# --- Reddit — preferred free path ------------------------------------------
# A "script" app at https://www.reddit.com/prefs/apps gets you these two
# values for free, BUT as of 2026 Reddit gates new app creation behind its
# "Responsible Builder Policy" approval (self-service registration is
# closed) — see README for the current status. Leave blank until approved;
# the Reddit collector automatically falls back to Apify (below) meanwhile.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=packages-group-monitor/1.0

# --- Apify (LinkedIn / Facebook / Instagram always; Reddit until approved) -
# Get a free-tier token at https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Actor IDs are configurable, never hard-coded. These defaults are real,
# currently-listed Apify Store actors whose input/output schema the
# matching collector in backend/app/collectors/ is already built against
# (verified against each actor's Store listing) — swap any of them for a
# different actor if you prefer, but you'll need to adjust that
# collector's _build_run_input/_normalize to match the new schema.
# Check each actor's current pricing on its Store page before enabling
# scheduled collection — they're pay-per-result, not flat-rate.
APIFY_LINKEDIN_ACTOR=harvestapi/linkedin-post-search
APIFY_REDDIT_ACTOR=trudax/reddit-scraper-lite
APIFY_FACEBOOK_ACTOR=scraper_one/facebook-posts-search
APIFY_INSTAGRAM_ACTOR=apify/instagram-hashtag-scraper

# --- Cost / collection safety limits ---------------------------------------
MAX_POSTS_PER_RUN=20
MAX_COMMENTS_PER_RUN=100
MAX_RUN_COST_USD=0.50
COLLECTION_INTERVAL_MINUTES=60
# Off by default — flip to true only once you're ready for unattended,
# recurring Apify usage across all four platforms.
ENABLE_SCHEDULER=false

# --- Search keywords: sent AS QUERIES to each collector (Reddit/LinkedIn/
# Instagram run one actor search per entry, so more entries directly means
# more run time and Apify cost) — kept to canonical full names only.
SEARCH_KEYWORDS=Packages Group,Packages Limited,Packages Pakistan,Packages Mall,Packages Convertors,Packages Group Pakistan

# --- Relevance keywords: LOCAL filter applied to already-collected text
# (comma separated, editable without code changes), so it's safe — and
# doesn't cost anything — to be broader here than SEARCH_KEYWORDS above.
# Includes common short forms alongside full names ("Packages Ltd", "Pkgs
# Mall", etc.) so casual mentions still match. Bare 2-3 letter acronyms
# ("PM", "PG") are deliberately left out — see backend/app/services/
# relevance.py — they false-positive too heavily on unrelated chatter
# ("PM" = Prime Minister, time-of-day, etc.) to be usable.
RELEVANCE_KEYWORDS=Packages Group,Packages Limited,Packages Pakistan,Packages Mall,Packages Convertors,Packages Group Pakistan,Packages Grp,Packages Ltd,Packages Pak,Pkg Mall,Pkgs Mall,Packages Conv,Pkgs Convertors,Packages Grp Pakistan,Pkgs Group Pakistan

# --- Negative sentiment spike detection ------------------------------------
SPIKE_THRESHOLD_PERCENT=100

# --- App ---------------------------------------------------------------
BACKEND_CORS_ORIGINS=http://localhost:5173
ENVIRONMENT=development
